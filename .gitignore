/result
/target
# Detached dogfood crate has its own target directory
/dogfood/target
/.direnv/
mprocs.log
*.local.*
performance_report.*
# Visual regression test outputs (regenerated)
/target/visual_test_outputs/
/target/visual_test_diffs/
# Local benchmark history (tracked on benchmark-history branch in CI)
.benchmark-history/
# Node.js dependencies for benchmark scripts
scripts/node_modules/
docs/gallery/thumbs/*.png

# Agent git worktrees (separate checkouts)
.claude/worktrees/
# Parked integration crates (GUP-390) are excluded from the workspace, so
# building one by hand creates its own lockfile (and its own target directory
# unless CARGO_TARGET_DIR is set).
/gup-egui/Cargo.lock
/gup-egui/target
/gup-bevy/Cargo.lock
/gup-bevy/target
/gup-ios/Cargo.lock
/gup-ios/target
/gup-android/Cargo.lock
/gup-android/target
/examples/gup-tauri/src-tauri/Cargo.lock
/examples/gup-tauri/src-tauri/target
