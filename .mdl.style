all
exclude_rule 'MD056'
exclude_rule 'MD007'
# MD005 conflicts with prettier's list indentation normalisation
exclude_rule 'MD005'
# MD041 fires on agent config files with YAML front-matter
exclude_rule 'MD041'
# MD024 is intentional in story retrospectives (repeated section headers)
exclude_rule 'MD024'
# MD026 is intentional in headers ending with ':'
exclude_rule 'MD026'
# MD033 is used intentionally for HTML formatting in docs
exclude_rule 'MD033'
# MD034 is used intentionally for URLs in docs
exclude_rule 'MD034'
# MD036 is used intentionally for bold text section labels in retrospectives
exclude_rule 'MD036'
# MD031 and MD040: pre-existing violations in docs not yet formatted with prettier
exclude_rule 'MD031'
exclude_rule 'MD040'
rule 'MD013', :line_length => 130, :tables => false, :ignore_code_blocks => true
rule 'MD029', :style => :one_or_ordered
